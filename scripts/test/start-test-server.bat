@echo off
REM FakEmby Test Server Launcher
cd /d "%~dp0..\.."

REM M0-2: 管理密钥不再有可用的出厂默认值，从环境变量取
set "ADMIN_KEY=%FAKEMBY_ADMIN_API_KEY%"
if "%ADMIN_KEY%"=="" set "ADMIN_KEY=admin-key"

echo.
echo ========================================
echo    FakEmby Test Server Launcher
echo ========================================
echo.

echo [1/4] Stopping old processes...
for /f "tokens=5" %%a in ('netstat -ano ^| findstr ":8096"') do taskkill /PID %%a /F 2>nul
timeout /t 1 /nobreak >nul
echo   OK

echo [2/4] Clean database + Build...
del /f fakemby.db 2>nul
set CGO_ENABLED=0
go build -o fakemby.exe .\cmd\fakemby >nul 2>&1
if %errorlevel% neq 0 (
    echo   Build FAILED!
    pause
    exit /b 1
)
echo   Build OK, DB cleaned

echo [3/4] Starting server...
start "" ".\fakemby.exe"
timeout /t 3 /nobreak >nul

REM Wait for server
set RETRY=0
:check_server
curl -s http://localhost:8096/emby/System/Info/Public >nul 2>&1
if %errorlevel% equ 0 goto server_ready
set /a RETRY+=1
if %RETRY% lss 10 (timeout /t 1 /nobreak >nul & goto check_server)
echo   Server start FAILED
pause
exit /b 1
:server_ready
echo   Server ready

